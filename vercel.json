{
  "version": 3,
  "builds": [
    { "src": "package.json", "use": "@vercel/node" },
    {
      "src": "vite.config.ts",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/backend/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
